{
  "regions": [
    "dub1"
  ],
  "functions": {
    "src/app/api/**": {
      "maxDuration": 30
    },
    "src/app/api/admin/ai/**": {
      "maxDuration": 300
    },
    "src/app/api/cron/**": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-morning",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/daily-evening",
      "schedule": "0 17 * * *"
    }
  ]
}
