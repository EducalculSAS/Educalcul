# Copie ce fichier en .env.local et remplis les valeurs. Ne jamais committer .env.local.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mets JAMAIS de secret.

# ── Supabase (obligatoire) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : serveur uniquement. Sert aussi de base pour signer les liens de partage et chiffrer les commentaires
# (son absence fait échouer ces fonctions en production, volontairement).
SUPABASE_SERVICE_ROLE=

# ── Adresse du site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://educalcul.vercel.app

# ── Stripe (paiements) ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── IA Mistral (Calia, génération de contenu) ──────────────────────────
MISTRAL_API_KEY=
MISTRAL_MODEL=
# Optionnels : MISTRAL_VISION_MODEL, MISTRAL_FALLBACK_MODEL, MISTRAL_REQUEST_TIMEOUT_MS, MISTRAL_MIN_REQUEST_INTERVAL_MS, MISTRAL_JSON_SCHEMA_MODE

# ── E-mails (Gmail, mot de passe d'application) ────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NAME_FROM=Educalcul
ADMIN_EMAIL_FROM=

# ── Connexion Google ───────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Tâches planifiées (Vercel Cron) et référencement ───────────────────
# Le même secret doit être configuré dans Vercel : il protège toutes les routes /api/cron/*.
CRON_SECRET=
INDEXNOW_SECRET=

# ── Divers (optionnels) ────────────────────────────────────────────────
IPINFO_TOKEN=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
