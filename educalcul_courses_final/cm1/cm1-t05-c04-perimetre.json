                      "content": "6 + 8 + 5 = 19 cm."
                    }
                  ]
                },
                {
                  "title": "Étape 2 : Soustraire du périmètre",
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": "28 - 19 = 9 cm."
                    }
                  ]
                },
                {
                  "title": "Étape 3 : Conclure",
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": "Le côté manquant mesure 9 cm."
                    }
                  ]
